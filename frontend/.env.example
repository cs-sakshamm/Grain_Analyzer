# Grain Analyzer frontend environment.
# Copy this file to `.env.local` and adjust to your deployment.
#
# VITE_API_BASE_URL: base URL of the grain-analysis backend, without a
# trailing slash. Example (PLACEHOLDER — replace with the real deployment):
#   https://api.example-grain-analyzer.test
# When this variable is absent or empty, the app runs in an explicit
# disconnected state and makes NO network requests.
#
# Never put secrets or credentials in frontend environment variables —
# everything here is bundled into the client.
VITE_API_BASE_URL=
